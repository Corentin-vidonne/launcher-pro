{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Launcher Pro",
  "version": "../package.json",
  "identifier": "fr.launcherpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Launcher Pro",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://art.localhost https: data:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Corentin Vidonne",
    "copyright": "Copyright (c) 2026 Corentin Vidonne. Licence MIT.",
    "category": "Game",
    "shortDescription": "Launcher de jeux unifié pour Windows",
    "longDescription": "Tous vos jeux PC (Steam, Epic, EA, Xbox, HoYoPlay, Battle.net…) détectés automatiquement dans une seule bibliothèque, avec comparateur de prix, recherche rapide et mode TV.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
